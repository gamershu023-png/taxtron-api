{
  "expo": {
    "name": "Taxtron",
    "slug": "taxtron-app",
    "owner": "taxtronofficials-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "taxtron",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["android"],
    "android": {
      "package": "in.taxtron.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "targetSdkVersion": 36,
      "minSdkVersion": 24
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "extra": {
      "eas": {
        "projectId": "e0ee06f5-558d-42b7-a438-b05acb5508c7"
      }
    }
  }
}
