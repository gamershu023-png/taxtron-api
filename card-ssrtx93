<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Taxtron AI — Card Manager & Remote Sync Hub (/card-ssrtx93)</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #020617;
      --card-bg: rgba(15, 23, 42, 0.6);
      --border-color: rgba(30, 41, 59, 0.8);
      --primary: #38bdf8;
      --secondary: #818cf8;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg-color);
      color: var(--text-main);
      padding: 40px 20px;
      line-height: 1.6;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    header {
      text-align: center;
      margin-bottom: 40px;
    }

    header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      background: linear-gradient(to right, #38bdf8, #818cf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    header p {
      color: var(--text-muted);
      font-size: 15px;
    }

    /* FORM STYLES */
    .admin-card {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 30px;
      margin-bottom: 40px;
      box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-group input, .form-group textarea {
      background: rgba(2, 6, 23, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 12px 16px;
      color: white;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.3s;
    }

    .form-group input:focus, .form-group textarea:focus {
      border-color: var(--primary);
    }

    .btn-group {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      font-weight: 700;
      border: none;
      border-radius: 12px;
      padding: 12px 24px;
      cursor: pointer;
      font-size: 14px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(56, 189, 248, 0.3);
    }

    .btn-outline {
      background: transparent;
      border: 1px solid var(--primary);
      color: var(--primary);
    }

    .btn-outline:hover {
      background: rgba(56, 189, 248, 0.1);
    }

    /* PREVIEW & LIST SECTIONS */
    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 20px;
      color: var(--text-main);
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .preview-card {
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.4), rgba(2, 6, 23, 0.7));
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 24px;
      position: relative;
    }

    .preview-card h3 {
      margin: 0 0 10px;
      font-size: 1.2rem;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .preview-card p {
      margin: 0 0 15px;
      font-size: 14px;
      color: var(--text-muted);
    }

    .preview-card .tag {
      display: inline-block;
      background: rgba(129, 140, 248, 0.15);
      color: var(--secondary);
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
    }

    .delete-btn {
      position: absolute;
      top: 15px;
      right: 15px;
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      border-radius: 8px;
      padding: 4px 8px;
      cursor: pointer;
      font-size: 12px;
    }

    .delete-btn:hover {
      background: rgba(239, 68, 68, 0.4);
    }

    /* CODE EXPORTER */
    .export-box {
      background: #090d16;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      padding: 20px;
      color: #38bdf8;
      font-family: monospace;
      font-size: 13px;
      overflow-x: auto;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>Taxtron Remote Card Manager</h1>
    <p>Endpoint Page: <code>/card-ssrtx93</code> — Add, edit, and sync feature cards dynamically to index.html</p>
  </header>

  <!-- ADD CARD FORM -->
  <div class="admin-card">
    <h2 style="margin-top:0; margin-bottom: 20px; font-size:1.3rem;">➕ Create New Feature Card</h2>
    <form id="cardForm" onsubmit="addCard(event)">
      <div class="form-grid">
        <div class="form-group">
          <label>Card Title</label>
          <input type="text" id="title" placeholder="e.g., AI Essay Grader" required>
        </div>
        <div class="form-group">
          <label>Emoji / Icon</label>
          <input type="text" id="icon" placeholder="e.g., ✍️" value="⚡" required>
        </div>
        <div class="form-group">
          <label>Target URL</label>
          <input type="text" id="url" placeholder="e.g., /tools/essay-grader" required>
        </div>
        <div class="form-group">
          <label>Category Tag</label>
          <input type="text" id="tag" placeholder="e.g., Student Utility" value="Utility">
        </div>
      </div>
      <div class="form-group" style="margin-bottom: 20px;">
        <label>Description</label>
        <textarea id="description" rows="2" placeholder="Briefly describe what this tool or page does..." required></textarea>
      </div>
      <div class="btn-group">
        <button type="submit" class="btn">Save &amp; Publish Card</button>
        <button type="button" class="btn btn-outline" onclick="exportHTML()">Generate HTML Snippet</button>
        <button type="button" class="btn btn-outline" onclick="clearCards()">Reset Cards</button>
      </div>
    </form>
  </div>

  <!-- ACTIVE CARDS PREVIEW -->
  <div class="section-title">Active Dynamic Cards</div>
  <div class="cards-grid" id="cardsPreview">
    <!-- Cards render dynamically -->
  </div>

  <!-- EXPORT SNIPPET OUTPUT -->
  <div class="section-title">Remote HTML Output Snippet</div>
  <p style="color: var(--text-muted); font-size: 14px;">Copy this output to return directly from your server endpoint or API response for <code>/card-ssrtx93</code>:</p>
  <div class="export-box" id="exportBox">&lt;!-- Click 'Generate HTML Snippet' above --&gt;</div>
</div>

<script>
  // DEFAULT INITIAL CARDS
  const defaultCards = [
    {
      id: "card_1",
      title: "AI Essay Grader",
      icon: "📝",
      url: "/tools/essay-grader",
      tag: "Students",
      description: "Instantly grade, evaluate grammar, and get detailed structure recommendations for essays."
    },
    {
      id: "card_2",
      title: "YT Thumbnail AI Ideas",
      icon: "🎬",
      url: "/create?tool=thumbnail",
      tag: "Creators",
      description: "Generate high-CTR thumbnail prompts and color themes tailored for your video concept."
    }
  ];

  // LOAD CARDS
  function getStoredCards() {
    const data = localStorage.getItem('taxtron_remote_cards');
    return data ? JSON.parse(data) : defaultCards;
  }

  function saveCards(cards) {
    localStorage.setItem('taxtron_remote_cards', JSON.stringify(cards));
    renderCards();
  }

  // RENDER CARDS TO PREVIEW
  function renderCards() {
    const cards = getStoredCards();
    const container = document.getElementById('cardsPreview');
    container.innerHTML = '';

    if (cards.length === 0) {
      container.innerHTML = '<p style="color:var(--text-muted);">No active cards. Create one above!</p>';
      return;
    }

    cards.forEach(card => {
      const cardEl = document.createElement('div');
      cardEl.className = 'preview-card';
      cardEl.innerHTML = `
        <button class="delete-btn" onclick="deleteCard('${card.id}')">✕ Delete</button>
        <h3>${card.icon} ${card.title}</h3>
        <p>${card.description}</p>
        <span class="tag">${card.tag}</span>
      `;
      container.appendChild(cardEl);
    });

    exportHTML();
  }

  // ADD CARD
  function addCard(e) {
    e.preventDefault();
    const cards = getStoredCards();
    
    const newCard = {
      id: 'card_' + Date.now(),
      title: document.getElementById('title').value.trim(),
      icon: document.getElementById('icon').value.trim() || '⚡',
      url: document.getElementById('url').value.trim(),
      tag: document.getElementById('tag').value.trim() || 'Utility',
      description: document.getElementById('description').value.trim()
    };

    cards.push(newCard);
    saveCards(cards);

    // Reset Form
    document.getElementById('cardForm').reset();
    document.getElementById('icon').value = '⚡';
    document.getElementById('tag').value = 'Utility';
  }

  // DELETE CARD
  function deleteCard(id) {
    let cards = getStoredCards();
    cards = cards.filter(c => c.id !== id);
    saveCards(cards);
  }

  // CLEAR ALL CARDS
  function clearCards() {
    if(confirm("Are you sure you want to clear all dynamic cards?")) {
      saveCards([]);
    }
  }

  // EXPORT HTML SNIPPET FOR INDEX.HTML
  function exportHTML() {
    const cards = getStoredCards();
    let htmlSnippet = '';

    cards.forEach(card => {
      htmlSnippet += `<div class="card" onclick="triggerRedirect('${card.url}', 'LOADING ${card.title.toUpperCase()}...')">
  <h3>${card.icon} ${card.title}</h3>
  <p>${card.description}</p>
</div>\n`;
    });

    document.getElementById('exportBox').textContent = htmlSnippet || '<!-- No cards available -->';
  }

  // INITIALIZE ON LOAD
  renderCards();
</script>

</body>
</html>
